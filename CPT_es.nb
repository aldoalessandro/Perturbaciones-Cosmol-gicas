(* Beginning of Notebook Content *)
Notebook[{
Cell["Teor\[IAcute]a de Perturbaciones Cosmol\[OAcute]gicas", "Title",
 FontWeight->"Bold",
 FontColor->GrayLevel[1],
 Background->RGBColor[0.8324, 0.3336, 0.0616]],

Cell["Ecuaciones de Einstein perturbadas en el gauge longitudinal", "Subtitle",
 FontSize->18,
 FontColor->GrayLevel[1],
 Background->RGBColor[0.7017, 0.217, 0.0727]],

Cell[CellGroupData[{

Cell["Cr\[EAcute]ditos", "Section",
 FontColor->RGBColor[0.7017, 0.217, 0.0727]],

Cell[TextData[{
 "Este notebook es una adaptaci\[OAcute]n del notebook ",
 StyleBox["Cosmological Perturbation Theory",
  FontSlant->"Italic"],
 " de Daniel Baumann (basado a su vez en un notebook de Yi Wang, Hong Kong \
University, y en material de James Hartle, UC Santa Barbara). Se tradujo al \
espa\[NTilde]ol y se cambi\[OAcute] a la notaci\[OAcute]n de la tesis: firma \
(\[Minus],+,+,+), tiempo conforme como primera coordenada y tensores en \
componentes mixtas."
}], "Text"]
}, Closed]],

Cell[CellGroupData[{

Cell["Definiciones", "Section",
 FontColor->RGBColor[0.7017, 0.217, 0.0727]],

Cell[CellGroupData[{

Cell["Entrada", "Subsection"],

Cell[TextData[{
 StyleBox["Coordenadas.",
  FontWeight->"Bold"],
 " En ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " los \[IAcute]ndices de los arreglos empiezan en 1 (no en 0). Por eso el \
\[IAcute]ndice 1 corresponde al tiempo conforme \[Eta] (\[Mu] = 0) y los \
\[IAcute]ndices 2, 3, 4 a las coordenadas espaciales x, y, z (i = 1, 2, 3). \
Es decir, la componente \[Mu] del texto es la componente \[Mu] + 1 del c\
\[OAcute]digo."
}], "Text"],

Cell["\<\
n = 4;
coord = {\[Eta], x, y, z};\
\>", "Input"],

Cell[TextData[{
 StyleBox["M\[EAcute]trica.",
  FontWeight->"Bold"],
 " La m\[EAcute]trica perturbada en el gauge longitudinal (newtoniano \
conforme), con firma (\[Minus],+,+,+), es"
}], "Text"],

Cell["ds\.b2 = a\.b2(\[Eta]) [ \[Minus](1 + 2\[CapitalPsi]) d\[Eta]\.b2 + (1 \
\[Minus] 2\[CapitalPhi]) \[Delta]\:1d62\:2c7c dx\:2071 dx\:02b2 ]", \
"DisplayFormula",
 TextAlignment->Center],

Cell["\<\
\[CapitalPsi] es el potencial que aparece en la componente temporal (el an\
\[AAcute]logo del potencial newtoniano) y \[CapitalPhi] el que aparece en la \
parte espacial (perturbaci\[OAcute]n de curvatura).\
\>", "Text"],

Cell["\<\
metrica = a[\[Eta]]^2 DiagonalMatrix[{
     -(1 + 2 \[Epsilon] \[CapitalPsi][\[Eta], x, y, z]),
       1 - 2 \[Epsilon] \[CapitalPhi][\[Eta], x, y, z],
       1 - 2 \[Epsilon] \[CapitalPhi][\[Eta], x, y, z],
       1 - 2 \[Epsilon] \[CapitalPhi][\[Eta], x, y, z]}];
MatrixForm[metrica]\
\>", "Input",
 CellLabel->"In[2]:="],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       SuperscriptBox[
        RowBox[{"a", "[", "\[Eta]", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", "\[Epsilon]", " ", 
          RowBox[{"\[CapitalPsi]", "[", 
           RowBox[{"\[Eta]", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
        ")"}]}], "0", "0", "0"},
     {"0", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"a", "[", "\[Eta]", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "\[Epsilon]", " ", 
          RowBox[{"\[CapitalPhi]", "[", 
           RowBox[{"\[Eta]", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
        ")"}]}], "0", "0"},
     {"0", "0", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"a", "[", "\[Eta]", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "\[Epsilon]", " ", 
          RowBox[{"\[CapitalPhi]", "[", 
           RowBox[{"\[Eta]", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
        ")"}]}], "0"},
     {"0", "0", "0", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"a", "[", "\[Eta]", "]"}], "2"], " ", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"2", " ", "\[Epsilon]", " ", 
          RowBox[{"\[CapitalPhi]", "[", 
           RowBox[{"\[Eta]", ",", "x", ",", "y", ",", "z"}], "]"}]}]}], 
        ")"}]}]}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[BoxForm`e$]]]], "Output",
 CellLabel->"Out[2]="],

Cell["\<\
Las perturbaciones van multiplicadas por un par\[AAcute]metro \[Epsilon] para \
poder llevar la cuenta del orden de cada t\[EAcute]rmino. Aqu\[IAcute] solo \
interesa el primer orden en \[Epsilon]; al final se toma \[Epsilon] = 1.\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Simplificaci\[OAcute]n de resultados", "Subsection"],

Cell["\<\
La siguiente funci\[OAcute]n limpia los resultados: introduce el \
par\[AAcute]metro de Hubble conforme \[ScriptCapitalH] = a\[Prime]/a, \
descarta los t\[EAcute]rminos de orden \[Epsilon]\.b2 (o superior) y agrupa \
por potencias de \[Epsilon].\
\>", "Text"],

Cell["\<\
simp[expr_] := Map[
   Collect[
     Normal[Series[# /. Derivative[1][a][\[Eta]] -> \[ScriptCapitalH][\[Eta]] \
a[\[Eta]], {\[Epsilon], 0, 1}]],
     \[Epsilon], Simplify] &,
   expr, {ArrayDepth[expr]}];\
\>", "Input"],

Cell[TextData[{
 "Habr\[AAcute] muchas funciones de (\[Eta], x, y, z), lo cual se vuelve dif\
\[IAcute]cil de leer. Para mejorar la lectura, el siguiente bloque muestra en \
",
 StyleBox["rojo",
  FontWeight->"Bold"],
 " las funciones del espacio-tiempo, en ",
 StyleBox["morado",
  FontWeight->"Bold"],
 " las funciones solo del tiempo, escribe las cantidades de fondo \[Rho]b, Pb \
como \[Rho]\:0304, P\:0304 y presenta las derivadas en forma compacta. Por \
ejemplo, \[CapitalPhi]\:207d\.b9'\:2070'\:2070'\:2070\:207e[\[Eta],x,y,z] se \
muestra como \[PartialD]\[Eta] \[CapitalPhi] y \[CapitalPhi]\:207d\.b9'\.b9'\
\:2070'\:2070\:207e[\[Eta],x,y,z] como \[PartialD]\[Eta]x \[CapitalPhi]."
}], "Text"],

Cell[TextData[{
 "Si se prefiere la notaci\[OAcute]n est\[AAcute]ndar de ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 ", basta con no evaluar este bloque."
}], "Text"],

Cell["\<\
PdBox[lst_] := StyleBox[#, FontSize -> 10] &@
   GridBox[#, Selectable -> True, ColumnSpacings -> 0, RowSpacings -> 0] &@
   Transpose@DeleteCases[Transpose[Map[ToBoxes, lst, {2}]] /. {\"1\", dn_} :> \
{\"\", dn}, {\"0\", _}];

MakeBoxes[Derivative[d__][f_][x__], StandardForm] :=
  TagBox[RowBox[{GridBox[{{\"\[PartialD]\", PdBox[{{d}, {x}}],
        GridBox[{{ToBoxes[f[x]]}}, Selectable -> True]}},
       ColumnSpacings -> 0, RowSpacings -> 0], \"\"}], \"GRED\", Selectable \
-> False] /;
   Length[{x}] > 1 && VectorQ[{d}, NumberQ] && VectorQ[{x}, AtomQ] &&
    Length[DeleteDuplicates[{x}]] === Length[{x}];

(* funciones del espacio-tiempo en rojo *)
With[{fx = f_ @@ coord},
  MakeBoxes[fx, StandardForm] := TagBox[StyleBox[ToBoxes[f], Red], \"GREFX\", \
Selectable -> False]];

(* funciones solo del tiempo conforme en morado *)
With[{fx = f_[coord[[1]]]},
  MakeBoxes[fx, StandardForm] := TagBox[StyleBox[ToBoxes[f], Purple], \
\"GREFX0\", Selectable -> False]];

(* cantidades de fondo con barra *)
MakeBoxes[\[Rho]b, StandardForm] := OverscriptBox[\"\[Rho]\", \"_\"];
MakeBoxes[Pb, StandardForm] := OverscriptBox[\"P\", \"_\"];\
\>", "Input"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Tensor de curvatura", "Section",
 FontColor->RGBColor[0.7017, 0.217, 0.0727]],

Cell["\<\
A partir de la m\[EAcute]trica (dada como una matriz de 4\[Times]4) se \
calculan\
\>", "Text"],

Cell["\[CapitalGamma]^\[Lambda]_\[Mu]\[Nu] = \.bd g^\[Lambda]\[Sigma] (\
\[PartialD]_\[Mu] g_\[Sigma]\[Nu] + \[PartialD]_\[Nu] g_\[Sigma]\[Mu] \
\[Minus] \[PartialD]_\[Sigma] g_\[Mu]\[Nu]),", "DisplayFormula",
 TextAlignment->Center],

Cell["\<\
R^\[Lambda]_\[Mu]\[Nu]\[Sigma] = \[PartialD]_\[Nu] \[CapitalGamma]^\[Lambda]_\
\[Mu]\[Sigma] \[Minus] \[PartialD]_\[Sigma] \[CapitalGamma]^\[Lambda]_\[Mu]\
\[Nu] + \[CapitalGamma]^\[Eta]_\[Mu]\[Sigma] \[CapitalGamma]^\[Lambda]_\[Eta]\
\[Nu] \[Minus] \[CapitalGamma]^\[Eta]_\[Mu]\[Nu] \[CapitalGamma]^\[Lambda]_\
\[Eta]\[Sigma],\
\>", "DisplayFormula",
 TextAlignment->Center],

Cell["R_\[Mu]\[Nu] = R^\[Lambda]_\[Mu]\[Lambda]\[Nu],     R = g^\[Mu]\[Nu] R_\
\[Mu]\[Nu],", "DisplayFormula",
 TextAlignment->Center],

Cell["G_\[Mu]\[Nu] = R_\[Mu]\[Nu] \[Minus] \.bd g_\[Mu]\[Nu] R,     G^\[Mu]_\
\[Nu] = g^\[Mu]\[Sigma] G_\[Sigma]\[Nu].", "DisplayFormula",
 TextAlignment->Center],

Cell[CellGroupData[{

Cell["C\[AAcute]lculo", "Subsection"],

Cell[TextData[{
 "La sintaxis ",
 StyleBox["christoffel := christoffel = ...",
  FontWeight->"Bold"],
 " hace que cada tensor se calcule solo la primera vez que se usa; despu\
\[EAcute]s el resultado queda guardado y no se vuelve a calcular."
}], "Text"],

Cell["\<\
metricaInv = simp[Inverse[metrica]];

christoffel := christoffel = simp[Table[
     1/2 Sum[metricaInv[[l, s]] (D[metrica[[s, m]], coord[[k]]] + \
D[metrica[[s, k]], coord[[m]]]
          - D[metrica[[m, k]], coord[[s]]]), {s, 1, n}],
     {l, 1, n}, {m, 1, n}, {k, 1, n}]];

riemann := riemann = simp[Table[
     D[christoffel[[l, m, s]], coord[[k]]] - D[christoffel[[l, m, k]], \
coord[[s]]]
      + Sum[christoffel[[h, m, s]] christoffel[[l, h, k]] - christoffel[[h, \
m, k]] christoffel[[l, h, s]], {h, 1, n}],
     {l, 1, n}, {m, 1, n}, {k, 1, n}, {s, 1, n}]];

ricci := ricci = simp[Table[Sum[riemann[[l, m, l, k]], {l, 1, n}], {m, 1, n}, \
{k, 1, n}]];

escalar := escalar = simp[Sum[metricaInv[[m, k]] ricci[[m, k]], {m, 1, n}, \
{k, 1, n}]];

einstein := einstein = simp[ricci - 1/2 escalar metrica];

einsteinMixto := einsteinMixto = simp[Table[
     Sum[metricaInv[[m, s]] einstein[[s, k]], {s, 1, n}], {m, 1, n}, {k, 1, \
n}]];\
\>", "Input"],

Cell["\<\
\[OpenCurlyDoubleQuote]einstein\[CloseCurlyDoubleQuote] es el tensor de \
Einstein con ambos \[IAcute]ndices abajo, G_\[Mu]\[Nu], y \
\[OpenCurlyDoubleQuote]einsteinMixto\[CloseCurlyDoubleQuote] es el tensor con \
un \[IAcute]ndice arriba y otro abajo, G^\[Mu]_\[Nu], que es la forma usada \
en la tesis. En las tablas siguientes los \[IAcute]ndices ya est\[AAcute]n \
escritos como en el texto (0 = \[Eta]; 1, 2, 3 = x, y, z).\
\>", "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["S\[IAcute]mbolos de Christoffel", "Subsection"],

Cell["\<\
listaChristoffel = Table[
   If[christoffel[[l, m, k]] =!= 0,
    {Subsuperscript[\"\[CapitalGamma]\", Row[{m - 1, k - 1}], l - 1], \"=\", \
christoffel[[l, m, k]]}],
   {l, 1, n}, {m, 1, n}, {k, 1, m}];
TableForm[DeleteCases[Flatten[listaChristoffel /. \[Epsilon] -> 1, 2], Null], \
TableSpacing -> {2, 2}]\
\>", "Input",
 CellLabel->"In[6]:="],

