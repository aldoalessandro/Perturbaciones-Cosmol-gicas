Cell[CellGroupData[{

Cell["Tensor de energ\[IAcute]a-momento", "Section",
 FontColor->RGBColor[0.7017, 0.217, 0.0727]],

Cell[TextData[{
 StyleBox["Fluido perfecto perturbado.",
  FontWeight->"Bold"],
 " Para un fluido perfecto,"
}], "Text"],

Cell["T^\[Mu]_\[Nu] = (\[Rho] + P) u^\[Mu] u_\[Nu] + P \
\[Delta]^\[Mu]_\[Nu],", "DisplayFormula",
 TextAlignment->Center],

Cell["\<\
con \[Rho] = \[Rho]\:0304 + \[Delta]\[Rho], P = P\:0304 + \[Delta]P y \
cuadrivelocidad u^\[Mu] = a\:207b\.b9(1 \[Minus] \[CapitalPsi], v\:2071), u_\
\[Mu] = a(\[Minus](1 + \[CapitalPsi]), v\:1d62). La componente temporal queda \
fijada por la normalizaci\[OAcute]n u^\[Mu] u_\[Mu] = \[Minus]1. \
\[OpenCurlyDoubleQuote]uU\[CloseCurlyDoubleQuote] es u^\[Mu], \
\[OpenCurlyDoubleQuote]uD\[CloseCurlyDoubleQuote] es u_\[Mu] y \
\[OpenCurlyDoubleQuote]tem\[CloseCurlyDoubleQuote] es T^\[Mu]_\[Nu].\
\>", "Text"],

Cell["\<\
vel = \[Epsilon] {v[1][\[Eta], x, y, z], v[2][\[Eta], x, y, z], v[3][\[Eta], \
x, y, z]};
uU = Prepend[vel, 1 - \[Epsilon] \[CapitalPsi][\[Eta], x, y, z]]/a[\[Eta]];
uD = Prepend[vel, -(1 + \[Epsilon] \[CapitalPsi][\[Eta], x, y, z])] \
a[\[Eta]];
\[Rho] = \[Rho]b[\[Eta]] + \[Epsilon] \[Delta]\[Rho][\[Eta], x, y, z];
P = Pb[\[Eta]] + \[Epsilon] \[Delta]P[\[Eta], x, y, z];

simp[uU . uD]   (* comprobaci\[OAcute]n de la normalizaci\[OAcute]n: debe dar \
-1 *)\
\>", "Input",
 CellLabel->"In[10]:="],

Cell[BoxData[
 RowBox[{"-", "1"}]], "Output",
 CellLabel->"Out[10]="],

Cell["\<\
tem := tem = simp[Table[(\[Rho] + P) uU[[m]] uD[[k]] + P KroneckerDelta[m, \
k], {m, 1, n}, {k, 1, n}]];
MatrixForm[tem]\
\>", "Input",
 CellLabel->"In[11]:="],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {
      RowBox[{
       RowBox[{
        RowBox[{"-", "\[Epsilon]"}], " ", 
        TagBox[
