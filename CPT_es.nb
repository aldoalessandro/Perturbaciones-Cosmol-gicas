Cell["Tensor de Ricci y escalar de curvatura", "Subsection"],

Cell["\<\
listaRicci = Table[
   If[ricci[[m, k]] =!= 0, {Subscript[\"R\", Row[{m - 1, k - 1}]], \"=\", \
ricci[[m, k]]}],
   {m, 1, n}, {k, 1, m}];
TableForm[DeleteCases[Flatten[listaRicci /. \[Epsilon] -> 1, 1], Null], \
TableSpacing -> {2, 2}]\
\>", "Input",
 CellLabel->"In[7]:="],

