Cell[CellGroupData[{

Cell["Tensor de Einstein (componentes mixtas)", "Subsection"],

Cell["\<\
listaEinstein = Table[
   If[einsteinMixto[[m, k]] =!= 0,
    {Subsuperscript[\"G\", k - 1, m - 1], \"=\", einsteinMixto[[m, k]]}],
   {m, 1, n}, {k, 1, n}];
TableForm[DeleteCases[Flatten[listaEinstein /. \[Epsilon] -> 1, 1], Null], \
TableSpacing -> {2, 2}]\
\>", "Input",
 CellLabel->"In[9]:="],

