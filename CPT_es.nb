Cell[TextData[{
 "Sin tensiones anis\[OAcute]tropas esta ecuaci\[OAcute]n exige \[PartialD]\
\:1d62\[PartialD]\:2c7c(\[CapitalPhi] \[Minus] \[CapitalPsi]) = 0, es decir \
",
 StyleBox["\[CapitalPhi] = \[CapitalPsi]",
  FontWeight->"Bold"],
 ". De aqu\[IAcute] en adelante se usa esta condici\[OAcute]n para eliminar \
\[CapitalPsi]."
}], "Text"],

