Cell[CellGroupData[{

Cell["Comparaci\[OAcute]n con la tesis", "Section",
 FontColor->RGBColor[0.7017, 0.217, 0.0727]],

Cell[TextData[{
 "Como verificaci\[OAcute]n, se restan del resultado de ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " las expresiones de G^\[Mu]_\[Nu] escritas en el Anexo 2 (sin imponer \
\[CapitalPhi] = \[CapitalPsi]). Todas las diferencias deben ser cero."
}], "Text"],

Cell["\<\
lap[f_] := D[f, x, x] + D[f, y, y] + D[f, z, z];
H = \[ScriptCapitalH][\[Eta]]; Fi = \[CapitalPhi][\[Eta], x, y, z]; Ps = \
\[CapitalPsi][\[Eta], x, y, z];

G00tesis = (-3 H^2 + \[Epsilon] (6 H (D[Fi, \[Eta]] + H Ps) - 2 lap[Fi]))/a[\
\[Eta]]^2;
G0xtesis = -2 \[Epsilon] D[D[Fi, \[Eta]] + H Ps, x]/a[\[Eta]]^2;
Gxxtesis = (-(2 \[ScriptCapitalH]'[\[Eta]] + H^2) + \[Epsilon] (lap[Ps - Fi] \
+ 2 D[Fi, \[Eta], \[Eta]]
       + 2 (2 \[ScriptCapitalH]'[\[Eta]] + H^2) Ps + 2 H D[Ps, \[Eta]] + 4 H \
D[Fi, \[Eta]])
       + \[Epsilon] D[Fi - Ps, x, x])/a[\[Eta]]^2;
Gxytesis = \[Epsilon] D[Fi - Ps, x, y]/a[\[Eta]]^2;

Simplify[{einsteinMixto[[1, 1]] - G00tesis, einsteinMixto[[1, 2]] - G0xtesis,
  einsteinMixto[[2, 2]] - Gxxtesis, einsteinMixto[[2, 3]] - Gxytesis}]\
\>", "Input",
 CellLabel->"In[22]:="],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"0", ",", "0", ",", "0", ",", "0"}], "}"}]], "Output",
 CellLabel->"Out[22]="]
}, Open  ]]
